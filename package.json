{
  "name": "portfolio-curator",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tinacms dev -c 'astro dev'",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook",
    "test:coverage": "vitest run --project storybook --coverage",
    "format": "biome format --write",
    "lint": "biome check --write",
    "check": "biome ci --error-on-warnings",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@lucide/astro": "^1.17.0",
    "astro": "^6.4.2",
    "tinacms": "^3.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@storybook-astro/framework": "^1.2.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-themes": "^10.4.2",
    "@storybook/builder-vite": "^10.4.1",
    "@tinacms/cli": "^2.4.4",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "happy-dom": "^20.9.0",
    "lefthook": "2.1.9",
    "storybook": "^10.4.1",
    "storybook-addon-pseudo-states": "^10.4.1",
    "vitest": "^4.1.7"
  }
}
