---
import Link from "@components/atoms/Link/Link.astro";
import site from "../../../../content/globals/site.json";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner wrap">
    <p>© {year} {site.footerCredit} · {site.footerTagline}</p>
    <nav aria-label="Footer">
      <ul class="site-footer__nav-list">
        {site.bottomNav.map(({ label, href }) => (
          <li>
            <Link href={href} variant="subtle">{label}</Link>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: var(--space-l);
    margin-top: var(--space-2xl);
    font-size: var(--step--1);
    color: var(--text-muted);
    background: var(--bg);
  }

  .site-footer__inner {
    display: flex;
    justify-content: space-between;
    gap: var(--space-l);
    flex-wrap: wrap;
  }

  .site-footer__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-m);
    flex-wrap: wrap;
  }
</style>
