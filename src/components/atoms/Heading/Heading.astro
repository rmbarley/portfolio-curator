---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"h1"> & {
  /** Semantic heading level. Always drives the rendered HTML element — use `visualSize` to change the visual weight, not `level`. */
  level: 1 | 2 | 3 | 4;
  /** Override visual size independently of semantic level. Maps to fluid type-scale tokens: `'6'`→`--step-6` down to `'1'`→`--step-1`. Defaults: h1→`'6'`, h2→`'4'`, h3→`'2'`, h4→`'1'`. */
  visualSize?: "6" | "5" | "4" | "3" | "2" | "1";
  /** Apply `text-wrap: balance` to avoid orphaned last-line words. Defaults `true` for h1/h2, `false` for h3/h4. */
  balance?: boolean;
  /** Fraunces `SOFT` optical axis (0–100). `30` = tight/high-contrast for hero use; `60` = default; `100` = open/warm for blockquotes and editorial contexts. */
  softness?: 30 | 60 | 100;
  /** Accepted as a prop so Storybook args work. In Astro templates, prefer passing content as a child slot — slot takes precedence. */
  children?: string;
};

const {
  level,
  visualSize,
  balance,
  softness = 60,
  children,
  class: className,
  style: styleProp,
  ...attrs
} = Astro.props;

const Tag = `h${level}` as const;

const defaultSize = { 1: "6", 2: "4", 3: "2", 4: "1" } as const;
const size = visualSize ?? defaultSize[level];

// balance defaults true for h1-h2, false for h3-h4
const shouldBalance = balance ?? level <= 2;

// opsz must be declared alongside SOFT — font-variation-settings doesn't cascade per-axis
const opszMap = { "6": 144, "5": 144, "4": 144, "3": 60, "2": 36, "1": 36 } as const;
const opsz = opszMap[size];

const variationStyle = `font-variation-settings: "opsz" ${opsz}, "SOFT" ${softness}`;
const style = styleProp ? `${variationStyle}; ${styleProp}` : variationStyle;
---

<Tag
  class:list={["heading", `heading--${size}`, { "heading--balance": shouldBalance }, className]}
  {style}
  {...attrs}
>
  <slot>{children}</slot>
</Tag>

<style>
  .heading {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--text);
    margin: 0 0 var(--space-m);
    text-wrap: auto;
  }

  .heading--balance {
    text-wrap: balance;
  }

  .heading--6 { font-size: var(--step-6); }
  .heading--5 { font-size: var(--step-5); }
  .heading--4 { font-size: var(--step-4); }
  .heading--3 { font-size: var(--step-3); }
  .heading--2 { font-size: var(--step-2); }
  .heading--1 { font-size: var(--step-1); }
</style>
