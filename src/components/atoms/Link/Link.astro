---
import "@styles/design-tokens.css";
import { ExternalLink } from "@lucide/astro";

interface Props {
  href: string;
  external?: boolean;
  variant?: "default" | "mono" | "subtle" | "brand" | "nav";
  children?: string;
}

const { href, external = false, variant = "default", children } = Astro.props;

const rel = external ? "noopener noreferrer" : null;
const target = external ? "_blank" : null;
---

<a href={href} rel={rel} target={target} class={`link--${variant}`}>
  <slot>{children}</slot>
  {
    external && (
      <>
        <ExternalLink size={14} aria-hidden="true" />
        <span class="sr-only">(opens in new tab)</span>
      </>
    )
  }
</a>

<style>
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .link--default {
    color: inherit;
  }

  .link--mono {
    color: var(--text-muted);
    font-size: 0.9em;
    font-family: var(--font-mono);
  }

  .link--subtle {
    color: var(--text-muted);
  }

  .link--brand {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    font-variation-settings:
      "opsz" 36,
      "SOFT" 60;

    &::after {
      content: ".";
      color: var(--accent);
      margin-left: -0.05em;
    }

    &:hover {
      color: var(--accent);
    }
  }

  .link--nav {
    text-decoration: none;
    color: var(--text-muted);
    font-size: var(--step--1);

    &:hover {
      color: var(--text);
    }
  }
</style>
