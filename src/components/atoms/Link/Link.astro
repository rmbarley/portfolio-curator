---
import type { HTMLAttributes } from "astro/types";
import "@styles/design-tokens.css";
import { ExternalLink, icons } from "@lucide/astro";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  external?: boolean;
  variant?: "default" | "mono" | "subtle" | "nav";
  iconTrailing?: string;
  children?: string;
}

const {
  href,
  external = false,
  variant = "default",
  iconTrailing,
  children,
  class: className,
  rel: relProp,
  target: targetProp,
  ...attrs
} = Astro.props;

const rel = external ? "noopener noreferrer" : (relProp ?? null);
const target = external ? "_blank" : (targetProp ?? null);
const TrailingIcon = iconTrailing
  ? icons[iconTrailing as keyof typeof icons]
  : null;
---

<a
  href={href}
  rel={rel}
  target={target}
  class:list={[`link--${variant}`, className]}
  {...attrs}
>
  <slot>{children}</slot>
  {TrailingIcon && <TrailingIcon size={14} aria-hidden="true" />}
  {
    external && (
      <>
        <ExternalLink size={14} aria-hidden="true" />
        <span class="sr-only">(opens in new tab)</span>
      </>
    )
  }
</a>

<style>
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .link--default {
    color: var(--text);
    &:hover {
      color: var(--accent);
    }
  }

  .link--mono {
    color: var(--text-muted);
    font-size: 0.9em;
    font-family: var(--font-mono);
  }

  .link--subtle {
    color: var(--text-muted);
  }

  .link--nav {
    text-decoration: none;
    color: var(--text-muted);
    font-size: var(--step--1);
    position: relative;

    &:hover {
      color: var(--text);
    }

    &[data-active="true"] {
      color: var(--text);

      &::before {
        content: "";
        position: absolute;
        left: -0.8rem;
        top: 50%;
        transform: translateY(-50%);
        width: 4px;
        height: 4px;
        background: var(--accent);
        border-radius: 50%;
      }
    }
  }
</style>
