---
type Props = {
  size?: "default" | "small";
  /**
   * HTML string injected via set:html. Used in Storybook stories so slot
   * content can be passed through args. In production, omit this and use
   * the default <slot /> instead.
   */
  children?: string;
};

const { size = "default", children } = Astro.props;
---

<div class:list={["prose", size === "small" && "prose--small"]}>
  {children && <Fragment set:html={children} />}
  <slot />
</div>

<style>
  .prose {
    font-size: var(--step-0);
    line-height: 1.7;
    max-width: var(--measure);
    color: var(--text);
  }

  .prose--small {
    font-size: var(--step--1);
    line-height: 1.6;
    max-width: 50ch;
  }

  /* ── Block elements ─────────────────────────────────────────── */

  .prose :global(p) {
    margin: 0 0 var(--space-m);
    text-wrap: pretty;
  }

  /* Small-caps treatment on the opening paragraph's first line */
  .prose :global(p:first-of-type::first-line) {
    font-variant: small-caps;
    letter-spacing: 0.05em;
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: var(--space-xl) 0 var(--space-m);
    color: var(--text);
    text-wrap: balance;
  }

  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: var(--space-l) 0 var(--space-s);
    color: var(--text);
    text-wrap: balance;
  }

  /* ── Lists ──────────────────────────────────────────────────── */

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.2em;
    margin: 0 0 var(--space-m);
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(li::marker) {
    color: var(--text-subtle);
  }

  /* ── Blockquote ─────────────────────────────────────────────── */

  .prose :global(blockquote) {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-variation-settings: "opsz" 36, "SOFT" 100;
    font-style: italic;
    line-height: 1.35;
    border-left: 2px solid var(--accent);
    padding: 0.2em 0 0.2em var(--space-m);
    margin: var(--space-l) 0;
    color: var(--text-muted);
  }

  /* ── Code ───────────────────────────────────────────────────── */

  .prose :global(code:not(pre code)) {
    font-family: var(--font-mono);
    font-size: 0.94em;
    background: var(--surface);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }

  .prose :global(pre) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-s);
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.55;
    tab-size: 2;
  }

  /* keyboard-scrollable: pre receives focus when it overflows */
  .prose :global(pre:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
