---
type Props = {
  date: Date | string;
  format?: "short" | "long" | "relative";
  tabular?: boolean;
  /** Reference date for relative formatting. Defaults to now. Only needed for tests. */
  now?: Date | string;
};

const { date, format = "short", tabular = false, now } = Astro.props;

// "YYYY-MM-DD" strings are spec'd as UTC midnight, so new Date(str) in a
// behind-UTC timezone gives the previous calendar day. Parse them as local
// calendar dates instead.
function parseLocalDate(value: Date | string): Date {
  if (typeof value === "string" && /^\d{4}-\d{2}-\d{2}$/.test(value)) {
    const [y, mo, d] = value.split("-").map(Number);
    return new Date(y, mo - 1, d);
  }
  return typeof value === "string" ? new Date(value) : value;
}

function localISODate(d: Date): string {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
}

const d = parseLocalDate(date);
const ref = now ? parseLocalDate(now) : new Date();

// Preserve the original string as-is when it's already YYYY-MM-DD; derive
// from local parts for Date objects so we never re-introduce UTC offset.
const iso =
  typeof date === "string" && /^\d{4}-\d{2}-\d{2}$/.test(date)
    ? date
    : localISODate(d);

function formatDate(d: Date, format: string, ref: Date): string {
  if (format === "long") {
    return d.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    });
  }

  if (format === "relative") {
    const diffMs = ref.getTime() - d.getTime();
    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
    if (diffDays === 0) return "today";
    if (diffDays === 1) return "yesterday";
    if (diffDays > 0 && diffDays < 14) return `${diffDays} days ago`;
    if (diffDays >= 14) {
      const diffWeeks = Math.floor(diffDays / 7);
      return `${diffWeeks} week${diffWeeks !== 1 ? "s" : ""} ago`;
    }
    // future date
    if (diffDays === -1) return "tomorrow";
    const absDays = Math.abs(diffDays);
    if (absDays < 14) return `in ${absDays} days`;
    const diffWeeks = Math.floor(absDays / 7);
    return `in ${diffWeeks} week${diffWeeks !== 1 ? "s" : ""}`;
  }

  // short: "Sep 20 · 2026"
  const month = d.toLocaleDateString("en-US", { month: "short" });
  const day = d.getDate();
  const year = d.getFullYear();
  return `${month} ${day} · ${year}`;
}

const displayText = formatDate(d, format, ref);
---

<time datetime={iso} class:list={[tabular && "time--tabular"]}>
  {displayText}
</time>

<style>
  .time--tabular {
    font-variant-numeric: tabular-nums;
  }
</style>
