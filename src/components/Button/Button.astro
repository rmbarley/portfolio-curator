---
import "../../styles/design-tokens.css";

interface Props {
  variant?: "primary" | "ghost" | "chip";
  size?: "sm" | "md";
  as?: "button" | "a";
  type?: "button" | "submit" | "reset";
  href?: string;
  pressed?: boolean;
  disabled?: boolean;
  /** SVG markup string. Must be developer-authored — never pass user or API content here (set:html, no sanitization). Replace with named slots when Lucide icons are wired up. */
  iconLeading?: string;
  /** SVG markup string. Same constraint as iconLeading. */
  iconTrailing?: string;
  children: string;
}

const {
  variant = "ghost",
  size = "md",
  as = "button",
  type = "button",
  href,
  pressed = false,
  disabled = false,
  iconLeading,
  iconTrailing,
  children,
} = Astro.props;

const Tag = as === "a" ? "a" : "button";

let attrs: Record<string, unknown> = {};
if (as === "a") {
  // <a> has no native disabled — use ARIA + remove href
  attrs = disabled ? { "aria-disabled": "true", tabindex: -1 } : { href };
} else {
  // <button> — defer to the browser's native disabled handling
  attrs = disabled ? { type, disabled: true } : { type };
}
---

<Tag
  class:list={[
    "btn",
    `btn--${variant}`,
    `btn--${size}`,
    { "btn--pressed": pressed },
  ]}
  aria-pressed={variant === "chip" ? pressed : undefined}
  {...attrs}
>
  {iconLeading && <Fragment set:html={iconLeading} />}
  {children}
  {iconTrailing && <Fragment set:html={iconTrailing} />}
</Tag>

<style>
  .btn {
    font-size: var(--step--1);
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    border: 1px solid var(--border-strong);
    color: var(--text);
    background: transparent;
    transition:
      background 0.15s,
      border-color 0.15s,
      color 0.15s;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .btn:disabled,
  .btn[aria-disabled="true"] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .btn--ghost:hover:not(:disabled):not([aria-disabled="true"]) {
    background: var(--surface);
    color: var(--accent);
  }

  .btn--primary {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .btn--primary:hover:not(:disabled):not([aria-disabled="true"]) {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: var(--bg);
  }

  .btn--chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    background: transparent;
  }

  .btn--chip[aria-pressed="true"] {
    color: var(--text);
    border-color: var(--border-strong);
    background: var(--surface);
  }

  .btn--sm {
    padding: 0.3rem 0.65rem;
    font-size: 0.75rem;
  }
</style>
