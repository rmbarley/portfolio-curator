---
import type { HTMLAttributes } from "astro/types";
import "../../styles/design-tokens.css";
import { icons } from "@lucide/astro";

type ButtonAttrs = HTMLAttributes<"button"> & { as?: "button" };
type AnchorAttrs = HTMLAttributes<"a"> & { as: "a" };

type Props = (ButtonAttrs | AnchorAttrs) & {
  variant?: "primary" | "ghost" | "chip";
  size?: "sm" | "md";
  pressed?: boolean;
  children: string;
  iconLeading?: keyof typeof icons;
  iconTrailing?: keyof typeof icons;
  disabled?: boolean;
};

const {
  variant = "primary",
  size = "md",
  as: Tag = "button",
  pressed,
  children,
  iconLeading,
  iconTrailing,
  disabled = false,
  ...attrs
} = Astro.props;

const LeadingIcon = iconLeading ? icons[iconLeading] : null;
const TrailingIcon = iconTrailing ? icons[iconTrailing] : null;
const disabledAttrs =
  Tag === "a" && disabled
    ? { "aria-disabled": "true", tabindex: -1 }
    : Tag === "button" && disabled
      ? { disabled: true }
      : {};
---

<Tag
  class:list={[
    "btn",
    `btn--${variant}`,
    `btn--${size}`,
    { "btn--pressed": pressed },
  ]}
  aria-pressed={variant === "chip" ? pressed : undefined}
  {...disabledAttrs}
  {...attrs as any}
>
  <slot name="icon-leading">
    {LeadingIcon && <LeadingIcon size={16} aria-hidden="true" />}
  </slot>

  <span>{children}</span>

  <slot name="icon-trailing">
    {TrailingIcon && <TrailingIcon size={16} aria-hidden="true" />}
  </slot>
</Tag>
<style>
  .btn {
    font-family: inherit;
    font-size: var(--step--1);
    padding: 0.55rem 0.95rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    border: 1px solid var(--border-strong);
    color: var(--text);
    background: transparent;
    transition:
      background 0.15s,
      border-color 0.15s,
      color 0.15s;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .btn:disabled,
  .btn[aria-disabled="true"] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .btn--ghost:hover:not(:disabled):not([aria-disabled="true"]) {
    background: var(--surface);
    color: var(--accent);
  }

  .btn--primary {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .btn--primary:hover:not(:disabled):not([aria-disabled="true"]) {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: var(--bg);
  }

  .btn--chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    background: transparent;
  }

  .btn--chip[aria-pressed="true"] {
    color: var(--text);
    border-color: var(--border-strong);
    background: var(--surface);
  }

  .btn--sm {
    padding: 0.3rem 0.65rem;
    font-size: 0.75rem;
  }
</style>
