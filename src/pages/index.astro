---
import Link from "@components/atoms/Link/Link.astro";
import HeroSection from "@components/organisms/HeroSection/HeroSection.astro";
import BaseLayout from "@layouts/BaseLayout/BaseLayout.astro";
import home from "../../content/home/index.json";
---

<BaseLayout width="wide" description={home.description}>
  <HeroSection
    lede={home.lede}
    intro={home.intro}
    primaryCta={home.primaryCta}
    secondaryCta={home.secondaryCta}
  >
    <span slot="aside">
      <p>{home.aside}</p>
      <Link href={home.asideLink.href} iconTrailing="ArrowRight">
        {home.asideLink.label}
      </Link>
    </span>
  </HeroSection>
</BaseLayout>
