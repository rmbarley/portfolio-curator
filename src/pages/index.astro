---
import Link from "@components/atoms/Link/Link.astro";
import HeroSection from "@components/organisms/HeroSection/HeroSection.astro";
import BaseLayout from "@layouts/BaseLayout/BaseLayout.astro";
---

<BaseLayout width="wide">
  <HeroSection
    primaryCta={{ label: "Read the latest", href: "/writing" }}
    secondaryCta={{ label: "The syllabus", href: "/now" }}
  >
    <span slot="lede">
      I write about the parts of software <em>engineers</em> still have to do.
    </span>
    <span slot="intro">
      <strong>Software engineer</strong>. Currently building AI-powered tools at
      Fountain Life. Recently finished an MS in Computer Science (AI
      concentration) at Georgia Tech. Writing my way from mid-level to staff in
      twelve months of structured study, in public.
    </span>
    <span slot="aside">
      <p>
        Twenty essays this year, written without AI. The Curator, a learning
        agent I built to help me stay on top of all this, grades each one
        against a public rubric before it gets published.
      </p>
      <Link href="/colophon" iconTrailing="ArrowRight">How I work</Link>
    </span>
  </HeroSection>
</BaseLayout>
