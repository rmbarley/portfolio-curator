---
import Heading from "@components/atoms/Heading/Heading.astro";
import BaseLayout from "@layouts/BaseLayout/BaseLayout.astro";
import page from "../../content/pages/building.json";
---

<BaseLayout
  title={`${page.heading} · Ryan Barley`}
  description={page.description}
  currentPath="/building"
>
  <Heading level={1} visualSize="5">{page.heading}</Heading>
  <p class="lede">{page.lede}</p>
  {page.body && <p class="lede">{page.body}</p>}
</BaseLayout>
