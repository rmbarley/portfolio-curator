---
import Heading from "@components/atoms/Heading/Heading.astro";
import ContactRow from "@components/molecules/ContactRow/ContactRow.astro";
import BaseLayout from "@layouts/BaseLayout/BaseLayout.astro";
import page from "../../content/pages/contact.json";
---

<BaseLayout
  title={`${page.heading} · Ryan Barley`}
  description={page.description}
  currentPath="/contact"
>
  <Heading level={1} visualSize="5">{page.heading}</Heading>
  <p class="lede">{page.lede}</p>
  <div class="contact-list">
    {
      page.channels.map((channel) => (
        <ContactRow
          label={channel.label}
          value={channel.value}
          href={channel.href}
          note={channel.note}
        />
      ))
    }
  </div>
</BaseLayout>

<style>
  .contact-list {
    display: grid;
    gap: var(--space-m);
  }
</style>
