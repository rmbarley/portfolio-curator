---
import "@styles/design-tokens.css";
import SiteFooter from "@components/organisms/SiteFooter/SiteFooter.astro";
import SiteHeader from "@components/organisms/SiteHeader/SiteHeader.astro";
import site from "../../../content/globals/site.json";

type Props = {
  /** Document `<title>` value. Defaults to 'Ryan Barley'. */
  title?: string;
  /** Optional `<meta name="description">` content. */
  description?: string;
  /** Passed to SiteHeader to highlight the active nav link. Defaults to '/'. */
  currentPath?: string;
  /** Show the theme toggle in SiteHeader. Defaults to `true`. */
  showThemeToggle?: boolean;
  /** `reading` constrains `<main>` to 44rem for prose pages. `wide` uses full container width. Defaults to `reading`. */
  width?: "reading" | "wide";
};

const {
  title = site.siteTitle,
  description,
  currentPath = "/",
  showThemeToggle = true,
  width = "reading",
} = Astro.props;

const googleFontsHref =
  "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,0..100&family=Geist:wght@300..600&family=JetBrains+Mono:wght@400;500&display=swap";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href={googleFontsHref}
      onload="this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href={googleFontsHref} />
    </noscript>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        if (stored === "light" || stored === "dark") {
          document.documentElement.setAttribute("data-theme", stored);
        } else if (window.matchMedia("(prefers-color-scheme: light)").matches) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader currentPath={currentPath} showThemeToggle={showThemeToggle} />
    <main
      id="main"
      class:list={["wrap", { "wrap--reading": width === "reading" }]}
    >
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  main.wrap {
    padding-block: var(--space-2xl);
  }
  main.wrap--reading {
    max-width: 44rem;
  }
  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    transform: translateY(-200%);
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    box-shadow: 0 0 0 1px var(--border-strong);
    z-index: 20;
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
